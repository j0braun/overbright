{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "import.schema.json",
  "title": "import.toml (ob.import/1.0)",
  "description": "import.md section 6: the import record of a base set made by the importer.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "^ob\\.import/1\\.[0-9]+$"
    },
    "importer": {
      "type": "object",
      "properties": {
        "overbright": {
          "$ref": "common.schema.json#/$defs/semver"
        },
        "epoch": {
          "$ref": "common.schema.json#/$defs/u32"
        },
        "finished": {
          "$ref": "common.schema.json#/$defs/date"
        }
      },
      "required": [
        "overbright",
        "epoch",
        "finished"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "edition": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,32}$"
        },
        "verdict": {
          "enum": [
            "known",
            "custom"
          ]
        },
        "identity": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "file_count": {
          "$ref": "common.schema.json#/$defs/u32"
        },
        "exe": {
          "type": "object",
          "properties": {
            "size": {
              "$ref": "common.schema.json#/$defs/u64"
            },
            "sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            }
          },
          "required": [
            "size",
            "sha256"
          ],
          "additionalProperties": false
        },
        "file": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "size": {
                "$ref": "common.schema.json#/$defs/u64"
              },
              "sha256": {
                "$ref": "common.schema.json#/$defs/sha256"
              },
              "unit": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              }
            },
            "required": [
              "path",
              "size",
              "sha256",
              "unit"
            ],
            "additionalProperties": false
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "reason": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "path",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "edition",
        "verdict",
        "identity",
        "file_count",
        "file"
      ],
      "additionalProperties": false
    },
    "bundle": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]{0,99}\\.obz$"
          },
          "size": {
            "$ref": "common.schema.json#/$defs/u64"
          },
          "digest": {
            "$ref": "common.schema.json#/$defs/digest"
          }
        },
        "required": [
          "name",
          "size",
          "digest"
        ],
        "additionalProperties": false
      }
    },
    "unit": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "version": {
            "$ref": "common.schema.json#/$defs/u32"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 240
            }
          },
          "items": {
            "$ref": "common.schema.json#/$defs/u64"
          },
          "model": {
            "$ref": "common.schema.json#/$defs/digest"
          },
          "proof": {
            "type": "object",
            "properties": {
              "bytes": {
                "$ref": "common.schema.json#/$defs/u64"
              },
              "values": {
                "$ref": "common.schema.json#/$defs/u64"
              },
              "kept": {
                "$ref": "common.schema.json#/$defs/u64"
              },
              "patched": {
                "$ref": "common.schema.json#/$defs/u64"
              },
              "copy": {
                "$ref": "common.schema.json#/$defs/u64"
              },
              "fill": {
                "$ref": "common.schema.json#/$defs/u64"
              },
              "external": {
                "$ref": "common.schema.json#/$defs/u64"
              }
            },
            "required": [
              "bytes",
              "values",
              "kept"
            ],
            "additionalProperties": false
          },
          "state": {
            "enum": [
              "kept",
              "decoded"
            ]
          }
        },
        "required": [
          "name",
          "version",
          "state",
          "files",
          "items",
          "model",
          "proof"
        ],
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "object",
      "properties": {
        "read_back": {
          "const": "pass"
        },
        "rebuild": {
          "const": "pass"
        },
        "profile": {
          "const": "pass"
        }
      },
      "required": [
        "read_back",
        "rebuild",
        "profile"
      ],
      "additionalProperties": false
    },
    "residual": {
      "type": "object",
      "properties": {
        "kept_bytes": {
          "$ref": "common.schema.json#/$defs/u64"
        },
        "shadow_bytes": {
          "$ref": "common.schema.json#/$defs/u64"
        }
      },
      "required": [
        "kept_bytes",
        "shadow_bytes"
      ],
      "additionalProperties": false
    },
    "journal": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "bundle": {
            "type": "string"
          },
          "state": {
            "enum": [
              "pending",
              "written",
              "done"
            ]
          },
          "from_schema": {
            "type": "string"
          },
          "to_schema": {
            "type": "string"
          }
        },
        "required": [
          "bundle",
          "state"
        ],
        "additionalProperties": false
      }
    },
    "extras": {
      "$ref": "common.schema.json#/$defs/extras"
    }
  },
  "required": [
    "schema",
    "importer",
    "source",
    "bundle",
    "unit",
    "checks",
    "residual"
  ],
  "additionalProperties": false
}
