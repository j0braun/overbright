{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "road-net.schema.json",
  "title": "ob.road-net: one track's road network (roads-ai.md 3.3)",
  "type": "object",
  "required": [
    "schema",
    "region",
    "track",
    "nodes",
    "segments"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "^ob\\.road-net/1\\.[0-9]+$"
    },
    "region": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]{2,8}$"
    },
    "track": {
      "$ref": "common.schema.json#/$defs/u16"
    },
    "nodes": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/arrayDescriptor"
        },
        {
          "properties": {
            "layout": {
              "const": "road_node"
            },
            "count": {
              "maximum": 65535
            }
          }
        }
      ]
    },
    "segments": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/arrayDescriptor"
        },
        {
          "properties": {
            "layout": {
              "const": "road_segment"
            },
            "count": {
              "maximum": 65535
            }
          }
        }
      ]
    },
    "paths": {
      "enum": [
        "region",
        "own"
      ]
    },
    "extras": {
      "$ref": "common.schema.json#/$defs/extras"
    },
    "ext": {
      "$ref": "common.schema.json#/$defs/ext"
    }
  }
}
