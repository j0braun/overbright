{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "race.schema.json",
  "title": "ob.race: a custom race of a mod pack (roads-ai.md 3.7)",
  "type": "object",
  "required": ["schema", "id", "track", "mode"],
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "string", "pattern": "^ob\\.race/1\\.[0-9]+$" },
    "op": { "const": "add" },
    "disabled": { "type": "boolean" },
    "id": { "type": "string", "pattern": "^[a-z0-9_-]{1,40}$" },
    "name": { "type": "string", "maxLength": 200, "pattern": "^[^\\u0000-\\u001F\\u007F]*$" },
    "track": { "$ref": "common.schema.json#/$defs/u16" },
    "backward": { "type": "boolean" },
    "mode": { "enum": ["circuit", "sprint", "streetx", "drift"] },
    "laps": { "type": "integer", "minimum": 1, "maximum": 20 },
    "checkpoints": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/xy" } },
    "grid": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/spot" } },
    "start": { "$ref": "#/$defs/spot" },
    "finish": { "$ref": "#/$defs/spot" },
    "extras": { "$ref": "common.schema.json#/$defs/extras" },
    "ext": { "$ref": "common.schema.json#/$defs/ext" }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "enum": ["sprint", "drift"] } }, "required": ["mode"] },
      "then": { "properties": { "laps": { "const": 1 } } }
    }
  ],
  "$defs": {
    "coord": {
      "description": "finite and within +-100000 (MAX_COORD); exact-bits escapes are not used here",
      "type": "number", "minimum": -100000, "maximum": 100000
    },
    "xy": { "type": "array", "items": { "$ref": "#/$defs/coord" }, "minItems": 2, "maxItems": 2 },
    "spot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "heading_deg"],
      "properties": {
        "position": { "type": "array", "items": { "$ref": "#/$defs/coord" }, "minItems": 3, "maxItems": 3 },
        "heading_deg": { "$ref": "#/$defs/coord" }
      }
    }
  }
}
