{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-routes.schema.json",
  "title": "ob.ai-routes: one AI route file (roads-ai.md 3.4)",
  "type": "object",
  "required": ["schema", "region", "name", "records", "points"],
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "string", "pattern": "^ob\\.ai-routes/1\\.[0-9]+$" },
    "region": { "type": "string", "pattern": "^[A-Za-z0-9]{2,8}$" },
    "name": { "type": "string", "pattern": "^([0-9]{1,5}[FB]|FreeRoam|All)$" },
    "engine_reads": { "type": "boolean" },
    "records": { "allOf": [ { "$ref": "common.schema.json#/$defs/arrayDescriptor" }, { "properties": { "layout": { "const": "route_record" }, "count": { "maximum": 4096 } } } ] },
    "points": { "allOf": [ { "$ref": "common.schema.json#/$defs/arrayDescriptor" }, { "properties": { "layout": { "const": "route_point" } } } ] },
    "junctions": { "allOf": [ { "$ref": "common.schema.json#/$defs/arrayDescriptor" }, { "properties": { "layout": { "const": "route_junction" }, "count": { "maximum": 65534 } } } ] },
    "intersections": { "allOf": [ { "$ref": "common.schema.json#/$defs/arrayDescriptor" }, { "properties": { "layout": { "const": "route_intersection" }, "count": { "maximum": 63 } } } ] },
    "extras": { "$ref": "common.schema.json#/$defs/extras" },
    "ext": { "$ref": "common.schema.json#/$defs/ext" }
  }
}
