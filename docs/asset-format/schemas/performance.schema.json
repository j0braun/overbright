{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "performance.schema.json",
  "title": "Overbright asset format: performance data (ob.performance)",
  "description": "cars.md 3.6. global/cars/performance.toml: the performance packages (career chunk 0x34A15), the tuning unlocks (0x34A1A), the rating bounds (GLOBALB 0x34A32) and the class curves (0x34A33), each in original order.",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "pattern": "^ob\\.performance/1\\.[0-9]+$" },
    "package": {
      "type": "array", "maxItems": 255,
      "items": {
        "type": "object",
        "properties": {
          "category": { "description": "+0x00 u32: 0 weight, 1 transmission, 2 nitrous, 3 engine, 4 turbo, 5 suspension, 6 brakes, 7 ECU, 8 tyres, 9 aerodynamics.", "type": "integer", "minimum": 0, "maximum": 255 },
          "level": { "description": "+0x04 u32: 1-3. (category, level) is the key.", "type": "integer", "minimum": 0, "maximum": 255 },
          "op": { "$ref": "common.schema.json#/$defs/op" },
          "part": {
            "description": "+0x0C: up to four 0x5C-byte parts; the count at +0x08. A keyed list (key: id).",
            "type": "array", "maxItems": 4,
            "items": {
              "type": "object",
              "properties": {
                "id": { "description": "+0x00 u32: performance part id 0-0x43.", "type": "integer", "minimum": 0, "maximum": 255 },
                "op": { "$ref": "common.schema.json#/$defs/op" },
                "name": { "description": "+0x04: its name, a language string hash (string:0x...).", "$ref": "common.schema.json#/$defs/hash32" },
                "price": { "description": "+0x08 u32.", "$ref": "common.schema.json#/$defs/u32" },
                "brands": { "description": "+0x10: up to eight brand hashes; the count at +0x0C.", "type": "array", "items": { "$ref": "common.schema.json#/$defs/hash32" }, "maxItems": 8 },
                "gains": { "description": "+0x30 f32[4]: per channel; -1 none.", "type": "array", "items": { "$ref": "common.schema.json#/$defs/f32" }, "minItems": 4, "maxItems": 4 },
                "replaces": { "description": "+0x40: up to five ids it stands in for.", "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 254 }, "maxItems": 5 },
                "requires": { "description": "+0x54: up to two ids it needs fitted first.", "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 254 }, "maxItems": 2 }
              },
              "required": ["id"],
              "additionalProperties": false
            }
          },
          "extras": { "$ref": "common.schema.json#/$defs/extras" }
        },
        "required": ["category", "level"],
        "additionalProperties": false
      }
    },
    "tuning_unlock": {
      "description": "0x34A1A: 24-byte records. Key: (part, param).",
      "type": "array", "maxItems": 4096,
      "items": {
        "type": "object",
        "properties": {
          "part": { "description": "+0x00 u32: the performance part id.", "type": "integer", "minimum": 0, "maximum": 255 },
          "param": { "description": "+0x05 u8: the tuning parameter it opens (0-24).", "type": "integer", "minimum": 0, "maximum": 255 },
          "op": { "$ref": "common.schema.json#/$defs/op" },
          "level": { "description": "+0x04 u8: 1-3.", "$ref": "common.schema.json#/$defs/u8" },
          "kind": { "description": "+0x06 u8: the slider kind.", "$ref": "common.schema.json#/$defs/u8" },
          "u_0x07": { "$ref": "common.schema.json#/$defs/u8" },
          "range": { "description": "+0x08 f32[2]: the parameter's range at that level.", "type": "array", "items": { "$ref": "common.schema.json#/$defs/f32" }, "minItems": 2, "maxItems": 2 },
          "display": { "description": "+0x10 f32[2]: the range the slider shows; -99.99 none.", "type": "array", "items": { "$ref": "common.schema.json#/$defs/f32" }, "minItems": 2, "maxItems": 2 }
        },
        "required": ["part", "param"],
        "additionalProperties": false
      }
    },
    "bounds": {
      "description": "GLOBALB 0x34A32: 30 f32 (the shops' stat ranges; +0x28/+0x2C rating bounds, +0x30..+0x6C handling-score normalisers, +0x70/+0x74 skill spread).",
      "type": "array", "items": { "$ref": "common.schema.json#/$defs/f32" }, "minItems": 30, "maxItems": 30
    },
    "class_curve": {
      "description": "GLOBALB 0x34A33: four 0x10C-byte rows, by performance class 0 (fastest) to 3.",
      "type": "object",
      "properties": {
        "0": { "$ref": "#/$defs/curve" },
        "1": { "$ref": "#/$defs/curve" },
        "2": { "$ref": "#/$defs/curve" },
        "3": { "$ref": "#/$defs/curve" }
      },
      "additionalProperties": false
    },
    "extras": { "$ref": "common.schema.json#/$defs/extras" },
    "ext": { "$ref": "common.schema.json#/$defs/ext" }
  },
  "required": ["schema"],
  "additionalProperties": false,
  "$defs": {
    "curve": {
      "type": "object",
      "properties": {
        "top_speed_mps": { "description": "+0x00 f32.", "$ref": "common.schema.json#/$defs/f32" },
        "u_0x04": { "description": "+0x04 f32[2]: open.", "type": "array", "items": { "$ref": "common.schema.json#/$defs/f32" }, "minItems": 2, "maxItems": 2 },
        "accel": { "description": "+0x0C f32[64]: acceleration, m/s^2, over 0..top speed.", "type": "array", "items": { "$ref": "common.schema.json#/$defs/f32" }, "minItems": 64, "maxItems": 64 }
      },
      "additionalProperties": false
    }
  }
}
