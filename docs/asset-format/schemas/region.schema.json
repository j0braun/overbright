{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "region.schema.json",
  "title": "world/<REGION>/region.toml (ob.region)",
  "description": "world.md 3.2: the stream-section table and the detail limit. Shape only; WLD.* rules are on the page.",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "pattern": "^ob\\.region/1\\.[0-9]+$" },
    "region": { "type": "string", "pattern": "^[A-Za-z0-9]{2,8}$" },
    "detail_limit": { "$ref": "common.schema.json#/$defs/u32" },
    "section": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/streamSection" } },
    "effects": {
      "description": "world.md 3.8: the region's particle effect descriptions (0x35021), opaque (stopgap)",
      "allOf": [
        { "$ref": "common.schema.json#/$defs/arrayDescriptor" },
        { "properties": { "layout": { "const": "emitter_description" } } }
      ]
    },
    "extras": { "$ref": "common.schema.json#/$defs/extras" },
    "ext": { "$ref": "common.schema.json#/$defs/ext" }
  },
  "required": ["schema", "region", "detail_limit", "section"],
  "additionalProperties": false,
  "$defs": {
    "streamSection": {
      "description": "Layout stream_section (0x50 bytes); pad rows are not written, u_ rows only when they differ from their default (0)",
      "type": "object",
      "properties": {
        "name": { "type": "string", "pattern": "^[\\x21-\\x7E]{1,7}$" },
        "number": { "$ref": "common.schema.json#/$defs/u32" },
        "u_0x10": { "$ref": "common.schema.json#/$defs/u32" },
        "stream_offset": { "$ref": "common.schema.json#/$defs/u32" },
        "stream_size": { "$ref": "common.schema.json#/$defs/u32" },
        "u_0x1c": { "$ref": "common.schema.json#/$defs/u32" },
        "u_0x20": { "$ref": "common.schema.json#/$defs/u32" },
        "u_0x24": { "$ref": "common.schema.json#/$defs/vec3" },
        "u_0x30": { "$ref": "common.schema.json#/$defs/u32" },
        "extras": { "$ref": "common.schema.json#/$defs/extras" }
      },
      "required": ["name", "number"],
      "additionalProperties": false
    }
  }
}
