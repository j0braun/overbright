{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tracks.schema.json",
  "title": "ob.tracks: the race-track records without their map fields (career.md 3.2)",
  "type": "object",
  "required": ["schema"],
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "string", "pattern": "^ob\\.tracks/1\\.[0-9]+$" },
    "track": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/track" } },
    "extras": { "$ref": "common.schema.json#/$defs/extras" },
    "ext": { "$ref": "common.schema.json#/$defs/ext" }
  },
  "$defs": {
    "text31": { "type": "string", "maxLength": 31, "pattern": "^[\\u0020-\\u007E]*$" },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number"],
      "properties": {
        "op": { "$ref": "common.schema.json#/$defs/op" },
        "disabled": { "type": "boolean" },
        "copy": { "description": "career.md 2: the k-th record of a duplicated number (k >= 2); absent for the first", "type": "integer", "minimum": 2, "maximum": 255 },
        "number": { "$ref": "common.schema.json#/$defs/u16" },
        "name": { "$ref": "#/$defs/text31" },
        "path": { "$ref": "#/$defs/text31" },
        "region": { "type": "string", "pattern": "^[A-Za-z0-9]{0,7}$" },
        "region_path": { "$ref": "#/$defs/text31" },
        "u_0x68": { "$ref": "common.schema.json#/$defs/u32" },
        "location": { "type": "string", "maxLength": 15, "pattern": "^[\\u0020-\\u007E]*$" },
        "icon": { "$ref": "common.schema.json#/$defs/u32" },
        "drift_kind": { "$ref": "common.schema.json#/$defs/u32" },
        "u_0x84": { "$ref": "common.schema.json#/$defs/u8" },
        "u_0x85": { "$ref": "common.schema.json#/$defs/u8" },
        "reversible": { "$ref": "common.schema.json#/$defs/u8" },
        "u_0x87": { "$ref": "common.schema.json#/$defs/u8" },
        "hidden": { "$ref": "common.schema.json#/$defs/u8" },
        "u_0x89": { "$ref": "common.schema.json#/$defs/u8" },
        "u_0x8c": { "$ref": "common.schema.json#/$defs/u16" },
        "u_0x8e": { "$ref": "common.schema.json#/$defs/u16" },
        "u_0x90": { "$ref": "common.schema.json#/$defs/u32" },
        "flags": { "$ref": "common.schema.json#/$defs/u32" },
        "length_m": { "$ref": "common.schema.json#/$defs/u32" },
        "default_record_ms": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/f32" }, "minItems": 2, "maxItems": 2 },
        "u_0xa4": { "type": "string", "pattern": "^hex:[0-9a-f]{16}$" },
        "u_0xb8": { "$ref": "common.schema.json#/$defs/u32" },
        "u_0xbc": { "$ref": "common.schema.json#/$defs/u32" },
        "u_0xc4": { "$ref": "common.schema.json#/$defs/u32" },
        "u_0xc8": { "$ref": "common.schema.json#/$defs/u32" },
        "u_0xcc": { "type": "string", "pattern": "^hex:[0-9a-f]{48}$" },
        "u_0xe4": { "$ref": "common.schema.json#/$defs/u32" },
        "u_0xe8": { "$ref": "common.schema.json#/$defs/u32" },
        "traffic": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/i8" }, "minItems": 8, "maxItems": 8 },
        "start_gap_off": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/u8" }, "minItems": 2, "maxItems": 2 },
        "start_kind": { "$ref": "common.schema.json#/$defs/i8" },
        "u_0xf7": { "$ref": "common.schema.json#/$defs/u8" },
        "start_gap_m": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/f32" }, "minItems": 2, "maxItems": 2 },
        "drag_fill_m": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/f32" }, "minItems": 2, "maxItems": 2 },
        "traffic_with": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/f32" }, "minItems": 4, "maxItems": 4 },
        "u_0x125": { "type": "string", "pattern": "^hex:[0-9a-f]{6}$" },
        "extras": { "$ref": "common.schema.json#/$defs/extras" }
      }
    }
  }
}
