{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "track-markers.schema.json",
  "title": "ob.track-markers: one TrackPosMarkers file (roads-ai.md 3.5)",
  "type": "object",
  "required": ["schema", "region", "name"],
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "string", "pattern": "^ob\\.track-markers/1\\.[0-9]+$" },
    "region": { "type": "string", "pattern": "^[A-Za-z0-9]{2,8}$" },
    "name": { "enum": ["All", "FreeRoam"] },
    "marker": {
      "type": "array",
      "maxItems": 65536,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "track", "position"],
        "properties": {
          "name": { "$ref": "route-paths.schema.json#/$defs/nameref" },
          "track": { "$ref": "common.schema.json#/$defs/u16" },
          "slot": { "$ref": "common.schema.json#/$defs/u32" },
          "position": { "$ref": "common.schema.json#/$defs/vec3" },
          "heading_bam16": { "$ref": "common.schema.json#/$defs/u16" },
          "u_0x22": { "$ref": "common.schema.json#/$defs/u16" },
          "u_0x28": { "type": "string", "pattern": "^hex:[0-9a-f]{16}$" },
          "extras": { "$ref": "common.schema.json#/$defs/extras" }
        }
      }
    },
    "extras": { "$ref": "common.schema.json#/$defs/extras" },
    "ext": { "$ref": "common.schema.json#/$defs/ext" }
  }
}
