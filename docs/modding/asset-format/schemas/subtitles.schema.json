{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "subtitles.schema.json",
  "title": "Overbright asset format: a movie's subtitle cues (ob.subtitles)",
  "description": "text.md section 3.7. movies/subtitles/<NAME>.toml: the timed labels of one SUBTITLES file; the text comes from the active language's strings.",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "pattern": "^ob\\.subtitles/1\\.[0-9]+$" },
    "op": { "$ref": "common.schema.json#/$defs/op" },
    "cue": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "time": { "description": "u16 time (unit open)", "type": "integer", "minimum": 0, "maximum": 65534 },
          "label_hash": { "$ref": "common.schema.json#/$defs/hash32" },
          "u_0x02": { "$ref": "common.schema.json#/$defs/u16" }
        },
        "required": ["time", "label_hash"],
        "additionalProperties": false
      },
      "maxItems": 8191
    },
    "end": {
      "description": "The closing record (time 0xFFFF)",
      "type": "object",
      "properties": {
        "label_hash": { "$ref": "common.schema.json#/$defs/hash32" },
        "u_0x02": { "$ref": "common.schema.json#/$defs/u16" }
      },
      "required": ["label_hash"],
      "additionalProperties": false
    },
    "extras": { "$ref": "common.schema.json#/$defs/extras" },
    "ext": { "$ref": "common.schema.json#/$defs/ext" }
  },
  "required": ["schema", "cue", "end"],
  "additionalProperties": false
}
