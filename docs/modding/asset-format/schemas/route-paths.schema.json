{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "route-paths.schema.json",
  "title": "ob.route-paths: a region's route triggers, barriers and checkpoint lists (roads-ai.md 3.2)",
  "type": "object",
  "required": ["schema", "region"],
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "string", "pattern": "^ob\\.route-paths/1\\.[0-9]+$" },
    "region": { "$ref": "#/$defs/region" },
    "trigger": { "type": "array", "maxItems": 65535, "items": { "$ref": "#/$defs/trigger" } },
    "barrier": { "type": "array", "maxItems": 65535, "items": { "$ref": "#/$defs/barrier" } },
    "checkpoints": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/checkpoints" } },
    "extras": { "$ref": "common.schema.json#/$defs/extras" },
    "ext": { "$ref": "common.schema.json#/$defs/ext" }
  },
  "$defs": {
    "region": { "type": "string", "pattern": "^[A-Za-z0-9]{2,8}$" },
    "nameref": {
      "description": "conventions.md 6.3 (nameref): a game name, or its bin_hash as hash32 when the name is unknown; a string starting with 0x is a hash (roads-ai.md 3.1 lists the importer's names)",
      "type": "string",
      "pattern": "^(0x[0-9A-F]{8}|(?!0x)[A-Za-z0-9_]{1,63})$"
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "position", "box_min", "box_max"],
      "properties": {
        "kind": { "type": "integer", "minimum": 0, "maximum": 20 },
        "position": { "$ref": "common.schema.json#/$defs/vec2" },
        "direction": { "$ref": "common.schema.json#/$defs/vec2" },
        "z_m": { "$ref": "common.schema.json#/$defs/f32" },
        "u_0x18": { "$ref": "common.schema.json#/$defs/u32" },
        "u_0x1c": { "$ref": "common.schema.json#/$defs/u32" },
        "box_min": { "$ref": "common.schema.json#/$defs/vec2" },
        "box_max": { "$ref": "common.schema.json#/$defs/vec2" },
        "name": { "$ref": "#/$defs/nameref" },
        "gps": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/i32" }, "minItems": 3, "maxItems": 3 },
        "traffic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rows", "caps_zone"],
          "properties": {
            "rows": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/u32" }, "minItems": 3, "maxItems": 3 },
            "caps_zone": { "$ref": "common.schema.json#/$defs/u32" }
          }
        },
        "polygon": { "type": "array", "maxItems": 255, "items": { "$ref": "common.schema.json#/$defs/vec2" } },
        "extras": { "$ref": "common.schema.json#/$defs/extras" }
      },
      "if": { "properties": { "kind": { "const": 16 } } },
      "then": { "required": ["traffic"], "not": { "anyOf": [ { "required": ["name"] }, { "required": ["gps"] } ] } },
      "else": { "not": { "required": ["traffic"] } }
    },
    "barrier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ends", "groups"],
      "properties": {
        "ends": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/vec2" }, "minItems": 2, "maxItems": 2 },
        "closed": { "$ref": "common.schema.json#/$defs/u8" },
        "held": { "$ref": "common.schema.json#/$defs/u8" },
        "u_0x13": { "$ref": "common.schema.json#/$defs/u8" },
        "groups": { "description": "+0x14: the barrier-group names (count +0x11, 0-4); slots past the count are zero in the record. Item key route-barrier:<REGION>/<i>.", "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/nameref" } },
        "extras": { "$ref": "common.schema.json#/$defs/extras" }
      }
    },
    "checkpoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track", "points"],
      "properties": {
        "track": { "$ref": "common.schema.json#/$defs/u16" },
        "loops": { "$ref": "common.schema.json#/$defs/u8" },
        "u_0x04": { "$ref": "common.schema.json#/$defs/u8" },
        "width_m": { "$ref": "common.schema.json#/$defs/u8" },
        "u_0x06": { "$ref": "common.schema.json#/$defs/u16" },
        "points": { "type": "array", "maxItems": 33, "items": { "$ref": "common.schema.json#/$defs/vec2" } },
        "extras": { "$ref": "common.schema.json#/$defs/extras" }
      }
    }
  }
}
