{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Overbright asset format: shared definitions",
  "description": "Definitions every other schema references (conventions.md). Applied to TOML documents after the standard TOML-to-JSON mapping. Shape only: cross-file rules are on the pages.",
  "$defs": {
    "schemaId": {
      "description": "conventions.md 3.3: ob.<kind>/<major>.<minor>",
      "type": "string",
      "pattern": "^ob\\.[a-z0-9]+(-[a-z0-9]+)*/[0-9]+\\.[0-9]+$"
    },
    "packId": {
      "description": "conventions.md 6.1",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "logicalPath": {
      "description": "conventions.md 6.2 (the 240-byte total limit is checked by readers)",
      "type": "string",
      "maxLength": 240,
      "pattern": "^(?!\\.\\.?/)(?!.*/\\.\\.?(/|$))[A-Za-z0-9_-][A-Za-z0-9._-]{0,99}(/[A-Za-z0-9_-][A-Za-z0-9._-]{0,99})*$"
    },
    "name": {
      "description": "conventions.md 6.3: a game-style name, printable ASCII, no leading or trailing space",
      "type": "string",
      "pattern": "^[!-~]([ -~]{0,61}[!-~])?$"
    },
    "hash32": {
      "description": "conventions.md 6.4: 0x + 8 upper-case hex digits",
      "type": "string",
      "pattern": "^0x[0-9A-F]{8}$"
    },
    "digest": {
      "description": "conventions.md 7",
      "type": "string",
      "pattern": "^(sha256:[0-9a-f]{64}|xxh3-128:[0-9a-f]{32})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ref": {
      "description": "conventions.md 6.6: <kind>:<key>",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[^\\s]{1,200}$"
    },
    "bytes": {
      "description": "conventions.md 3.2: hex: + even number of lower-case hex digits, at most 4096 bytes",
      "type": "string",
      "pattern": "^hex:([0-9a-f]{2}){0,4096}$"
    },
    "floatBits": {
      "description": "conventions.md 3.4: exact-bits escape for a float",
      "type": "string",
      "pattern": "^bits:0x([0-9A-F]{8}|[0-9A-F]{16})$"
    },
    "f32": {
      "description": "conventions.md 3.4: a float, or its exact bits",
      "oneOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/floatBits"
        }
      ]
    },
    "f64": {
      "$ref": "#/$defs/f32"
    },
    "u8": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "i8": {
      "type": "integer",
      "minimum": -128,
      "maximum": 127
    },
    "u16": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "i16": {
      "type": "integer",
      "minimum": -32768,
      "maximum": 32767
    },
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "i32": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    },
    "u64": {
      "type": "integer",
      "minimum": 0
    },
    "i64": {
      "type": "integer"
    },
    "vec2": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/f32"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "vec3": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/f32"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "vec4": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/f32"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "mat3": {
      "description": "conventions.md 5.3: row-major, rows are local axes, row vectors",
      "type": "array",
      "items": {
        "$ref": "#/$defs/f32"
      },
      "minItems": 9,
      "maxItems": 9
    },
    "color": {
      "description": "conventions.md 5.4: #RRGGBBAA, sRGB, straight alpha",
      "type": "string",
      "pattern": "^#[0-9A-F]{8}$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "arrayDescriptor": {
      "description": "conventions.md 4.4: an external array in a .bin file",
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]{0,99}(/[A-Za-z0-9_-][A-Za-z0-9._-]{0,99})*\\.bin$"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "multipleOf": 16
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "layout": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "file",
        "offset",
        "count",
        "layout"
      ],
      "additionalProperties": false
    },
    "op": {
      "description": "layering.md 3.1",
      "enum": [
        "merge",
        "add",
        "replace"
      ]
    },
    "extras": {
      "description": "conventions.md 9: free content for tools; never changes behaviour",
      "type": "object"
    },
    "ext": {
      "description": "conventions.md 9: extension tables, keyed by extension name",
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z0-9]+_[a-z0-9_]+$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "versionReq": {
      "description": "manifest.md: a version requirement such as >=0.4, >=1.2,<2, *",
      "type": "string",
      "pattern": "^(\\*|(>=|<=|>|<|=|\\^|~)?[0-9]+(\\.[0-9]+){0,2}(\\s*,\\s*(>=|<=|>|<|=)[0-9]+(\\.[0-9]+){0,2})*)$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "listKey": {
      "description": "layering.md 3.2: a base element's index in the base set's list, or <pack id>:<n> for an element a pack added",
      "oneOf": [
        {
          "$ref": "#/$defs/u32"
        },
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}:[0-9]{1,9}$"
        }
      ]
    }
  }
}
