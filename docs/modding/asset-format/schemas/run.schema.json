{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run.schema.json",
  "title": "A run file's record (ob.run)",
  "description": "runs.md: a run file is text, one record per line; each line read as an object of its named fields in order (record = the line's first word) is one of these. A reader skips records it does not know and the words after the fields it knows. Generated from the code (crates/ob-asset-format/src/kinds.rs); do not edit.",
  "oneOf": [
    {
      "$ref": "#/$defs/recordOBSIM"
    },
    {
      "$ref": "#/$defs/recordC"
    },
    {
      "$ref": "#/$defs/recordL"
    },
    {
      "$ref": "#/$defs/recordF"
    },
    {
      "$ref": "#/$defs/recordE"
    },
    {
      "$ref": "#/$defs/recordH"
    },
    {
      "$ref": "#/$defs/recordR"
    },
    {
      "$ref": "#/$defs/recordEND"
    }
  ],
  "$defs": {
    "recordOBSIM": {
      "description": "The header, the file's first line: its version, then `key=value` pairs.",
      "type": "object",
      "properties": {
        "record": {
          "const": "OBSIM"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "schema": {
          "type": "string",
          "pattern": "^ob\\.run/1\\.[0-9]+$"
        },
        "mode": {
          "enum": [
            "race",
            "world"
          ]
        },
        "seed": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        },
        "race": {
          "type": "string",
          "pattern": "^(-|[a-z0-9_-]{1,40})$"
        },
        "track": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "laps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "checkpoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "record",
        "version"
      ],
      "additionalProperties": false
    },
    "recordC": {
      "description": "A car's first appearance.",
      "type": "object",
      "properties": {
        "record": {
          "const": "C"
        },
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "kind": {
          "enum": [
            "P",
            "R",
            "T",
            "X"
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001F\\u007F|]*$"
        }
      },
      "required": [
        "record",
        "id",
        "kind"
      ],
      "additionalProperties": false
    },
    "recordL": {
      "description": "A car's look: before its first tick and again when it changes (a traffic slot taking another car).",
      "type": "object",
      "properties": {
        "record": {
          "const": "L"
        },
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "model": {
          "type": "string",
          "pattern": "^[!-{}~]{1,64}$"
        },
        "camber": {
          "$ref": "#/$defs/num"
        },
        "parts": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{2}:[0-9A-Fa-f]{8}$"
          }
        }
      },
      "required": [
        "record",
        "id",
        "model",
        "camber",
        "parts"
      ],
      "additionalProperties": false
    },
    "recordF": {
      "description": "One tick (the game's 60 Hz update) and every car in it.",
      "type": "object",
      "properties": {
        "record": {
          "const": "F"
        },
        "tick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "time": {
          "$ref": "#/$defs/num"
        },
        "cars": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/car"
          }
        }
      },
      "required": [
        "record",
        "tick",
        "time"
      ],
      "additionalProperties": false
    },
    "recordE": {
      "description": "An event of the tick before it.",
      "type": "object",
      "properties": {
        "record": {
          "const": "E"
        },
        "tick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "time": {
          "$ref": "#/$defs/num"
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z-]{0,31}$"
        },
        "car": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "checkpoint": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "value": {
          "$ref": "#/$defs/num"
        }
      },
      "required": [
        "record",
        "tick",
        "time",
        "kind",
        "car",
        "checkpoint",
        "value"
      ],
      "additionalProperties": false
    },
    "recordH": {
      "description": "The state hash, every 60 ticks and after the last tick: the same seed gives the same hashes, so a replay or a second run shows the tick where it parted.",
      "type": "object",
      "properties": {
        "record": {
          "const": "H"
        },
        "tick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        }
      },
      "required": [
        "record",
        "tick",
        "hash"
      ],
      "additionalProperties": false
    },
    "recordR": {
      "description": "A racer's result at the end.",
      "type": "object",
      "properties": {
        "record": {
          "const": "R"
        },
        "car": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "place": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "time": {
          "oneOf": [
            {
              "$ref": "#/$defs/num"
            },
            {
              "const": "-"
            }
          ]
        },
        "best": {
          "oneOf": [
            {
              "$ref": "#/$defs/num"
            },
            {
              "const": "-"
            }
          ]
        },
        "laps": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/num"
          }
        }
      },
      "required": [
        "record",
        "car",
        "place",
        "time",
        "best"
      ],
      "additionalProperties": false
    },
    "recordEND": {
      "description": "The end, the file's last line.",
      "type": "object",
      "properties": {
        "record": {
          "const": "END"
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "pattern": "^[^\\u0000-\\u001F\\u007F|]*$"
        }
      },
      "required": [
        "record",
        "why"
      ],
      "additionalProperties": false
    },
    "num": {
      "type": "number",
      "minimum": -1000000000,
      "maximum": 1000000000
    },
    "car": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "kind": {
          "enum": [
            "P",
            "R",
            "T",
            "X"
          ]
        },
        "x": {
          "$ref": "#/$defs/num"
        },
        "y": {
          "$ref": "#/$defs/num"
        },
        "z": {
          "$ref": "#/$defs/num"
        },
        "qx": {
          "$ref": "#/$defs/num"
        },
        "qy": {
          "$ref": "#/$defs/num"
        },
        "qz": {
          "$ref": "#/$defs/num"
        },
        "qw": {
          "$ref": "#/$defs/num"
        },
        "speed": {
          "$ref": "#/$defs/num"
        },
        "lap": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "checkpoint": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "place": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "steer0": {
          "$ref": "#/$defs/num"
        },
        "steer1": {
          "$ref": "#/$defs/num"
        },
        "roll0": {
          "$ref": "#/$defs/num"
        },
        "roll1": {
          "$ref": "#/$defs/num"
        },
        "roll2": {
          "$ref": "#/$defs/num"
        },
        "roll3": {
          "$ref": "#/$defs/num"
        },
        "lift0": {
          "$ref": "#/$defs/num"
        },
        "lift1": {
          "$ref": "#/$defs/num"
        },
        "lift2": {
          "$ref": "#/$defs/num"
        },
        "lift3": {
          "$ref": "#/$defs/num"
        },
        "lights": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      },
      "required": [
        "id",
        "kind",
        "x",
        "y",
        "z",
        "qx",
        "qy",
        "qz",
        "qw",
        "speed",
        "lap",
        "checkpoint",
        "place"
      ],
      "additionalProperties": false
    }
  }
}
