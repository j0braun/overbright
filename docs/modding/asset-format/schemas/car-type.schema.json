    "gearbox": {
      "$ref": "#/$defs/gearbox",
      "description": "record +0x2C0: Struct `gearbox` below"
    },
    "engine": {
      "type": "object",
      "properties": {
        "idle_rpm": {
          "$ref": "common.schema.json#/$defs/f32",
          "description": "record +0x300: verified"
        },
        "redline_rpm": {
          "$ref": "common.schema.json#/$defs/f32",
          "description": "record +0x304: verified"
        },
        "max_rpm": {
          "$ref": "common.schema.json#/$defs/f32",
          "description": "record +0x308: verified"
        },
        "inertia": {
          "$ref": "common.schema.json#/$defs/f32",
          "description": "record +0x30C: Crank inertia (0x5A12A0). verified"
        },
        "torque_knm": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/f32"
          },
          "minItems": 9,
          "maxItems": 9,
          "description": "record +0x310: Full-throttle torque over idle..max rpm (`Curve<9>`, 0x5764E0). verified"
        },
        "turbo_torque_knm": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/f32"
          },
          "minItems": 9,
          "maxItems": 9,
          "description": "record +0x334: Added into the torque by the setup (0x5A6E40) also when stock; the code's `curve_334`. verified use, name inferred"
        },
        "braking_knm": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/f32"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "record +0x358: Closed-throttle drag over idle..max rpm. verified"
        },
        "u_0x364": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/f32"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "record +0x364: open"
        }
      },
      "additionalProperties": false
    },
    "aero": {
      "type": "object",
      "properties": {
        "drag": {
          "$ref": "common.schema.json#/$defs/f32",
