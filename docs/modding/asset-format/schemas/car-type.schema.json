{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "car-type.schema.json",
  "title": "Overbright asset format: one car type (ob.car-type)",
  "description": "cars.md 3.2. One record of GLOBALB chunk 0x34600 (0x890 bytes) and its AI upgrade presets. Only schema and name are required by shape: a base set's file holds every non-default field, a mod pack's only the fields it changes (layering.md). Cross-file rules (CRS.*) are on the page.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "^ob\\.car-type/1\\.[0-9]+$"
    },
    "op": {
      "$ref": "common.schema.json#/$defs/op"
    },
    "disabled": {
      "type": "boolean",
      "description": "layering.md 3.1; refused for car types in 1.0 (MRG.3)"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]{1,31}$",
      "description": "record +0x000: Key. verified (looked up by name, src/car/record.rs:144)"
    },
    "skin_name": {
      "type": "string",
      "pattern": "^[\\x20-\\x7E]{0,31}$",
      "description": "record +0x020: Base of `<skin_name>_SKIN1` (render-info remap 0x631E30). verified. Default: `name`"
    },
    "geometry_path": {
      "type": "string",
      "pattern": "^[\\x20-\\x7E]{0,31}$",
      "description": "record +0x040: Non-empty = stock-car candidate (0x516500). verified as a test; the text is not used for loading. Default: `CARS\\<name>\\GEOMETRY.BIN`"
    },
    "geometry_lzc_path": {
      "type": "string",
      "pattern": "^[\\x20-\\x7E]{0,31}$",
      "description": "record +0x060: open (no reader known). Default: `CARS\\<name>\\GEOMETRY.LZC`"
    },
    "u_0x080": {
      "type": "string",
      "pattern": "^hex:([0-9a-f]{2}){64}$",
      "description": "record +0x080: open; zero in every record of the reference install"
    },
    "manufacturer": {
      "type": "string",
      "pattern": "^[\\x20-\\x7E]{0,15}$",
      "description": "record +0x0C0: Lot logo `CARSELECT_MANUFACTURER_<it>` (0x511E60). verified"
    },
    "name_hash": {
      "$ref": "common.schema.json#/$defs/hash32",
      "description": "record +0x0D0: = `bin_hash(name)` in every record. Derived; written only when it differs"
    },
    "u_0x0d4": {
      "$ref": "common.schema.json#/$defs/f32",
      "description": "record +0x0D4: open; one value in every record"
    },
    "u_0x0d8": {
      "$ref": "common.schema.json#/$defs/u8",
      "description": "record +0x0D8: open"
    },
    "skin_count": {
      "$ref": "common.schema.json#/$defs/u8",
      "description": "record +0x0D9: Traffic skin draw count (0x61BC30). verified"
    },
    "lot_flags": {
      "$ref": "common.schema.json#/$defs/u8",
      "description": "record +0x0DA: Bit 1: may be a stock car (0x516500). verified; other bits open"
    },
    "u_0x0db": {
      "$ref": "common.schema.json#/$defs/u8",
      "description": "record +0x0DB: open"
    },
    "rim_size": {
      "$ref": "common.schema.json#/$defs/u8",
      "description": "record +0x0DC: Rims fit when their attribute 0xCE7D8DB5 matches (0x539B80). verified"
    },
    "rim_min": {
      "$ref": "common.schema.json#/$defs/u8",
      "description": "record +0x0DD: Smallest rim the AI rim draw takes (0x632DF0). verified"
    },
    "rim_max": {
      "$ref": "common.schema.json#/$defs/u8",
      "description": "record +0x0DE: Largest rim of the unique-part list (0x533D30). verified"
    },
    "u_0x0df": {
      "$ref": "common.schema.json#/$defs/u8",
      "description": "record +0x0DF: open"
    },
    "u_0x0e0": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/f32"
      },
      "minItems": 12,
      "maxItems": 12,
      "description": "record +0x0E0: open; the same twelve values in every record"
    },
    "chassis": {
      "type": "object",
      "properties": {
        "centre_of_mass": {
          "$ref": "common.schema.json#/$defs/vec3",
          "description": "record +0x110: Tuning block +0x00 (the physics copies the record from here, 0x5AC500). verified"
        },
        "u_0x11c": {
          "$ref": "common.schema.json#/$defs/f32",
          "description": "record +0x11C: open"
        },
        "mass_tonne": {
          "$ref": "common.schema.json#/$defs/f32",
          "description": "record +0x220: verified (scaled by weight reduction, 0x5997F0)"
        },
        "dimensions": {
          "$ref": "common.schema.json#/$defs/vec3",
          "description": "record +0x224: Length, width, height; inferred from values"
        },
        "inertia_matrix": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/f32"
          },
          "minItems": 16,
          "maxItems": 16,
          "description": "record +0x230: 4×4, row-major; the diagonal +0x230/+0x244/+0x258 (roll, pitch, yaw) verified and recomputed from mass and dimensions by 0x5AC500; the other entries open"
        },
        "ground_yaw_inertia": {
          "$ref": "common.schema.json#/$defs/f32",
          "description": "record +0x270: Ground yaw-inertia factor (0x59B950; the code's `unknown_270`). verified"
        },
        "u_0x274": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/f32"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "record +0x274: open"
        }
      },
      "additionalProperties": false
    },
    "wheel": {
      "type": "object",
      "description": "record +0x120: Front left, front right, rear right, rear left; struct `wheel` below",
      "properties": {
        "fl": {
          "$ref": "#/$defs/wheel"
        },
        "fr": {
          "$ref": "#/$defs/wheel"
        },
        "rr": {
          "$ref": "#/$defs/wheel"
        },
        "rl": {
          "$ref": "#/$defs/wheel"
        }
      },
      "additionalProperties": false
    },
    "tyres": {
