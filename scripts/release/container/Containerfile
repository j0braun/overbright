# The release build image: Ubuntu 22.04 (glibc 2.35, so the Linux binary runs on every distribution
# with glibc >= 2.35), a pinned Rust toolchain with the Linux and the Windows (mingw-w64) standard
# libraries, and the mingw-w64 cross compiler. Nothing machine-specific: build.sh mounts the source,
# the crate cache and the target directories at run time. See scripts/release/container/README.md.
#
# The base image is pinned by digest (docker.io/library/ubuntu:22.04); the Rust components by version
# and SHA-256 (https://static.rust-lang.org/dist/<file>.sha256).
FROM docker.io/library/ubuntu@sha256:076e7bf82319619f28dd0aa9c02ab34b055ad37100395b4f49a2ffba04fb5e11

ARG RUST_VERSION=1.98.0
ARG SHA_RUSTC=0e37cb339f447fc44d6d781073bacacebfdc5612f2600e4c7e84c266f5f3aced
ARG SHA_CARGO=2f512d170d3dd23e16ababcda32ee2e6d5172d861a7af1f504e0b1e270cafab9
ARG SHA_STD_LINUX=f5022e6c95a5ad23cca2513dc8281200f585fa188de6370aa37b128a43f876a3
ARG SHA_STD_WINDOWS=c77b8a00e24205c1f9ab083e36c92def2a9ff3a7a4691bee996d878a5a127fb9

ENV DEBIAN_FRONTEND=noninteractive
# Linux: a C compiler (mimalloc), ALSA and udev headers (cpal, gilrs). Windows: mingw-w64 (gcc, windres,
# binutils). binutils for the checks (readelf, strings).
RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends \
      gcc g++ make cmake pkg-config libasound2-dev libudev-dev ca-certificates curl xz-utils binutils \
      gcc-mingw-w64-x86-64 g++-mingw-w64-x86-64 binutils-mingw-w64-x86-64 \
 && rm -rf /var/lib/apt/lists/*

# Rust from the official standalone component archives (no rustup): rustc, cargo, and the standard
# library for both targets, installed into /usr/local.
RUN set -e; cd /tmp; base=https://static.rust-lang.org/dist; \
    for pair in "rustc-$RUST_VERSION-x86_64-unknown-linux-gnu $SHA_RUSTC" \
                "cargo-$RUST_VERSION-x86_64-unknown-linux-gnu $SHA_CARGO" \
                "rust-std-$RUST_VERSION-x86_64-unknown-linux-gnu $SHA_STD_LINUX" \
                "rust-std-$RUST_VERSION-x86_64-pc-windows-gnu $SHA_STD_WINDOWS"; do \
      set -- $pair; \
      curl -fsSL -o "$1.tar.xz" "$base/$1.tar.xz"; \
      echo "$2  $1.tar.xz" | sha256sum -c -; \
      tar xJf "$1.tar.xz"; \
      "$1/install.sh" --prefix=/usr/local --disable-ldconfig >/dev/null; \
      rm -rf "$1" "$1.tar.xz"; \
    done; \
    rustc -V; cargo -V; ls /usr/local/lib/rustlib

# The Windows target links with mingw-w64's gcc; the cc crate (mimalloc) finds x86_64-w64-mingw32-gcc
# by the target's name.
ENV CARGO_TARGET_X86_64_PC_WINDOWS_GNU_LINKER=x86_64-w64-mingw32-gcc \
    WINDRES=x86_64-w64-mingw32-windres \
    CARGO_HOME=/cargo-home
