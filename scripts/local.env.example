# Machine-local settings of the check and perf scripts (docs/developing/checks.md "Machine setup").
# Copy to scripts/local.env (git-ignored) and edit; or point NFSU2_LOCAL_ENV at a file elsewhere.
# Every script sources it once (scripts/lib/common.sh) and logs which file it used ("local env ...").
# Plain bash: export what the scripts and the game should see.

# Required: the folder that holds the game's data (GLOBAL/, TRACKS/, ...). No default.
export NFSU2_ROOT="/path/to/Need for Speed Underground 2"

# Optional: the build environment for the checks' cargo builds (checks.sh). perf.sh build always
# builds the measured profile and unsets the usual fast-build variables itself.
# . /path/to/build-speedups.env
# export CARGO_BUILD_JOBS=6

# Optional, perf.sh: where the per-tree target dirs go (default <repo>/target/perf-work).
# export PERF_WORK=/big/disk/perf-work

# perfgate.sh: the accepted baselines (measured on this machine; never in the repo). Required by perfgate.sh.
# export PERF_BASELINES=/big/disk/perf-baselines

# perf.sh / budget.sh / perfgate.sh: the play-setup preset ("user"; "max" = it plus the newest rows).
# Lines as the bench takes them (NFSU2_BENCH_ENH): custom.N (World Detail) and enh.* values, ';'-separated.
# export PRESET_user="custom.0 3;custom.1 1;enh.post_aa 6;enh.ssao 25;enh.hdr_post 2"

# perf.sh IGPU=1 / budget.sh IGPU=1: the integrated GPU's MESA_VK_DEVICE_SELECT id (vendor:device, `vulkaninfo`).
# export IGPU_DEVICE=1002:164e

# perf.sh profile: a samply binary (default: samply on PATH).
# export SAMPLY=/path/to/samply

# gate.sh: extra rsync --exclude patterns for work dirs inside the tree (space separated).
# export GATE_EXCLUDE="mywork"

# Optional: a directory where gate.sh keeps the base binary per base source tree, so several gates against the
# same base build it once. Never inside the game's own cache or data folders (~/.cache/overbright,
# ~/.local/share/overbright): the checks fail when those change.
# export GATE_BASE_CACHE=/big/disk/gate-base

# halo.sh: the save of the reported rain scene (a profile file; default: the finished-career fixture).
# export HALO_SAVE=/path/to/PROFILE/PROFILE
